{
  "name": "@agentic-auto-correct/adapter-anthropic",
  "version": "1.0.0",
  "description": "Anthropic Claude adapter for agentic-auto-correct.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "files": ["dist"],
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "agentic-auto-correct": "workspace:^"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "agentic-auto-correct": "workspace:^",
    "tsup": "^8.5.1",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
